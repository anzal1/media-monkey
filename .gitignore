node_modules/
.env
out/
.DS_Store

# assets/bg/*.mp4 is KEPT on purpose: the procedural loops are the account's
# owned footage and take ~3 min each to re-record.
# Fetched stock clips are not: they are re-fetchable from sources.json.
assets/clips/**/*.mp4
assets/clips/.tmp-*
assets/bg/calm/
legacy/__pycache__/

# CI review renders: kept locally, too big for the repo
insights/visuals/ci/*.mp4

# machines-gen: the generated modules, fixtures and answers are the kill test's
# evidence and are kept; the private scene pages, shots and baseline are not
!factory/machines-gen/out/
factory/machines-gen/out/**/page/
factory/machines-gen/out/baseline/
